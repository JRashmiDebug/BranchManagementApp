@model IEnumerable<BranchManagementApp.Models.Branch>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Branch Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
        }

        h2 {
            margin-top: 20px;
        }

        .table-container {
            margin-top: 20px;
        }

        .btn {
            margin-right: 5px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2 class="text-center text-primary">Branch Management</h2>

        <div class="row mt-4">
            <div class="col-md-6">
                <label for="branchDropdown" class="form-label fw-bold">Select a Branch:</label>
                <select id="branchDropdown" class="form-select" onchange="fetchBranchDetails()">
                    <option value="">Select Branch</option>
                    @foreach (var item in ViewBag.BranchDropdown as List<SelectListItem>)
                    {
                        <option value="@item.Text">@item.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-6 text-end">
                <button class="btn btn-success" onclick="exportToExcel()">Export to Excel</button>
            </div>
        </div>

        <div class="table-container">
            <table class="table table-striped table-hover mt-4">
                <thead class="table-dark">
                    <tr>
                        <th>Branch</th>
                        <th>Person Name</th>
                        <th>Age</th>
                        <th>Mobile Number</th>
                        <th>Complete Address</th>
                        <th>Profession</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="branchTableBody">
                    @foreach (var branch in Model)
                    {
                        <tr>
                            <td>@branch.BranchName</td>
                            <td>@branch.PersonName</td>
                            <td>@branch.Age</td>
                            <td>@branch.MobileNumber</td>
                            <td>@branch.CompleteAddress</td>
                            <td>@branch.Profession</td>
                            <td>
                                @Html.ActionLink("Edit", "Edit", new { id = branch.Id }, new { @class = "btn btn-warning btn-sm" })
                                @Html.ActionLink("Delete", "Delete", new { id = branch.Id }, new { @class = "btn btn-danger btn-sm" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="text-end">
            @Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-primary" })
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        function fetchBranchDetails() {
            var branchId = document.getElementById('branchDropdown').value;

            if (!branchId || branchId === "Select Branch") {
                alert("Please select a valid branch.");
                return;
            }

            $.ajax({
                url: '/Home/GetBranchDetails',
                type: 'POST',
                data: { branchName: branchId },
                success: function (response) {
                    var tableBody = document.getElementById('branchTableBody');
                    tableBody.innerHTML = "";

                    response.data.forEach(function (item) {
                        var row = `<tr>
                                <td>${item.BranchName}</td>
                                <td>${item.PersonName}</td>
                                <td>${item.Age}</td>
                                <td>${item.MobileNumber}</td>
                                <td>${item.CompleteAddress}</td>
                                <td>${item.Profession}</td>
                                <td>
                                    <a href='/Home/Edit/${item.Id}' class='btn btn-warning btn-sm'>Edit</a>
                                    <a href='/Home/Delete/${item.Id}' class='btn btn-danger btn-sm'>Delete</a>
                                </td>
                            </tr>`;
                        tableBody.innerHTML += row;
                    });
                },
                error: function () {
                    alert("Error fetching branch details.");
                }
            });
        }

        function exportToExcel() {
            var branchName = document.getElementById('branchDropdown').value;

            if (!branchName || branchName === "Select Branch") {
                alert("Please select a valid branch.");
                return;
            }

            // Redirect to the export endpoint with the selected branch name
            window.location.href = '/Home/ExportToExcel?branchName=' + encodeURIComponent(branchName);
        }
    </script>
</body>
</html>
